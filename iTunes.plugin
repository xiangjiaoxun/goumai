[Script]
http-response ^https?:\/\/((sandbox|buy)\.itunes\.apple\.com)\/verifyReceipt$ script-path=https://raw.githubusercontent.com/xiangjiaoxun/goumai/main/iTunes.js, requires-body=true, timeout=10, tag=iTunes本地通用内购

[MITM]
hostname = buy.itunes.apple.com, sandbox.itunes.apple.com
